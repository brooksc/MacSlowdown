<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The only entitlement under test. Nothing else is granted, so the result
	     represents the most restrictive Mac App Store baseline. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
