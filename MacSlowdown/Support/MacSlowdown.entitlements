<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The only entitlement this app requests.
	     probe/FINDINGS.md establishes that everything MacSlowdown needs is
	     reachable under a plain App Sandbox with no exceptions: sysctl
	     KERN_PROC_ALL for enumeration, proc_pidinfo for per-process CPU and
	     resident memory, host_statistics64, thermal state and volume capacity.
	     Requesting anything further is where App Review rejections cluster. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Write access to exactly the file the user picks in a Save dialog, and
	     nothing else. FR-028's export has to produce a file the user can attach
	     themselves; without this the Save panel returns a URL the sandbox will not
	     let us write. It grants no ambient file access: Powerbox extends the
	     sandbox only to the chosen file, only when the user chooses it. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
